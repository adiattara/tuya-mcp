# Copy to .env and fill in. Never commit .env.
# Values come from https://iot.tuya.com > Cloud > your project.

# Overview tab > Authorization Key > Access ID/Client ID
TUYA_ACCESS_ID=
# Overview tab > Authorization Key > Access Secret/Client Secret
TUYA_ACCESS_SECRET=
# Devices tab > Link App Account > UID column
TUYA_UID=

# Optional
# EU: https://openapi.tuyaeu.com | US: https://openapi.tuyaus.com
# CN: https://openapi.tuyacn.com | IN: https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com
TUYA_CACHE_TTL=60
TUYA_LOG_LEVEL=WARNING
